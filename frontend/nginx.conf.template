server {
    listen 80;
    server_name localhost;

    # Dynamic DNS Resolver from /etc/resolv.conf
    resolver ${RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Static assets
    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests dynamically with variable so Nginx NEVER crashes on startup
    location /api/ {
        set $backend_api "http://${BACKEND_HOST}";
        proxy_pass $backend_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy health probes
    location /healthz {
        set $backend_health "http://${BACKEND_HOST}/healthz";
        proxy_pass $backend_health;
        proxy_http_version 1.1;
    }

    location /readyz {
        set $backend_ready "http://${BACKEND_HOST}/readyz";
        proxy_pass $backend_ready;
        proxy_http_version 1.1;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
